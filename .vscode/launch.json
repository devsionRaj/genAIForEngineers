{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current Node file",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/${input:javascriptFile}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Debug generated review crawler",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/rag-practice/run-generated-review-crawler.js",
            "args": [
                "${input:reviewCrawlerUrl}"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Debug 06_chatBetweenHiteshAndPiyush.js",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/section-1/06_chatBetweenHiteshAndPiyush.js",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ],
    "inputs": [
        {
            "id": "reviewCrawlerUrl",
            "type": "promptString",
            "description": "URL to crawl with the generated review function",
            "default": "https://bizratesurveys.com/reviews/lampsplus-reviews"
        },
        {
            "id": "javascriptFile",
            "type": "promptString",
            "description": "Workspace-relative JavaScript file to debug",
            "default": "section-1/04_cotTools.js"
        }
    ]
}